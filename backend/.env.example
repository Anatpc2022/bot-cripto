# Express port. ex: 3001
PORT=

# Frontend URL. ex: http://localhost:3000
CORS_ORIGIN=

#ex: mysecret
JWT_SECRET=

#Em segundos ex: 1800
JWT_EXPIRES=

# Nome do seu banco de dados. ex: riberBot
DB_NAME=

# Usuário do banco de dados. ex: root
DB_USER=

# Senha do banco de dados. ex: 123456
DB_PWD=

# Servidor do banco de dados. ex: localhost
DB_HOST=

# Porta do banco de dados. ex: 3306
DB_PORT=

# Dialeto do banco de dados. ex: mysql
DB_DIALECT=

#preencher seeder
DEFAULT_USER_EMAIL=
DEFAULT_USER_PWD=
DEFAULT_USER_TELEGRAM_CHAT=

# Node Binance API console logs. ex: true
BINANCE_LOGS=

# Você usa Binance Leveraged Tokens? ex: false
BINANCE_BLVT=

# Moedas ignoradas, separadas por vírgula. ex: AUD,NGN,GBP,EUR,RUB,UAH,TRY,BKRW,BIDR,ZAR,BVND,JPY
IGNORED_COINS=

# Sua moeda fiduciária principal. ex: USD
DEFAULT_FIAT=

# Seu par de chaves da Binance API.
ACCESS_KEY=
SECRET_KEY=

# Se deve logar o que está acontecendo no módulo riberBot. ex: false
RIBERBOT_LOGS=

# Se deve logar o que está acontecendo no módulo Exchange Monitor (app-em.js). ex: false
APP_EM_LOGS=

# Tempo mínimo (em ms) entre disparos de uma mesma automação. Ex: 30000
AUTOMATION_INTERVAL=

# Servidor de envio de email. Ex: gmail
SMTP_SERVER=

# Porta do servidor de envio de email. Ex: 587 se for gmail não precisa
SMTP_PORT=

# Se o servidor usa SSL/TLS ou não. Ex: false
SMTP_SECURE=

# Conta de email para envio. ex: ana.tpc2022@gmail.com
SMTP_USER=

# Senha da conta de email para envio. Ex: 123456
SMTP_PWD=